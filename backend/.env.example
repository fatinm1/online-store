FLASK_ENV=development
FLASK_SECRET_KEY=
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=sqlite:///numme.db
# Required in production -- shares rate-limit counters across gunicorn
# workers. Leave unset in dev; falls back to in-memory storage.
REDIS_URL=
FORCE_HTTPS=false
CURRENCY=usd
ADMIN_EMAIL=admin@numme.com
ADMIN_PASSWORD=change-me-now

# Required in production -- Railway's filesystem is ephemeral, so uploaded
# product images need object storage or they're lost on every deploy.
# Leave all unset in dev; uploads then fall back to local disk.
# Supabase Storage is S3-compatible (Project Settings > Storage > S3
# Connection) so these work with the Supabase project already used for
# DATABASE_URL -- any other S3-compatible provider works too.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# e.g. https://<project-ref>.supabase.co/storage/v1/object/public/<bucket>
S3_PUBLIC_URL_BASE=
